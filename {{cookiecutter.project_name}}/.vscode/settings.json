{
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true{% if cookiecutter.dvc or cookiecutter.mkdocs %},
  "yaml.schemas": {
    {% if cookiecutter.dvc %}"./{% if cookiecutter.layout == 'src' %}src/{% endif %}{{ cookiecutter.project_slug }}/schemas/params.schema.json": "params.yaml"{% endif %}{% if cookiecutter.dvc and cookiecutter.mkdocs %},
    {% endif %}{% if cookiecutter.mkdocs %}"https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml"{% endif %}
  }{% endif %}{% if cookiecutter.mkdocs %},
  "yaml.customTags": [
    "!ENV scalar",
    "!ENV sequence",
    "!relative scalar",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.to_svg",
    "tag:yaml.org,2002:python/name:material.extensions.emoji.twemoji",
    "tag:yaml.org,2002:python/name:pymdownx.superfences.fence_code_format",
    "tag:yaml.org,2002:python/object/apply:pymdownx.slugs.slugify mapping"
  ]{% endif %}
}
